{
  "name": "anatomy-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3016",
    "start": "vite preview --host 0.0.0.0 --port 3016",
    "test:connect": "node --test server/connect-address.test.mjs server/connect-relay.test.mjs",
    "test:connect-cloudflare": "node --test cloudflare/connect-worker.test.mjs",
    "test:connect-live": "node scripts/validate-live-connect.mjs",
    "connect:cloudflare:check": "wrangler deploy --config cloudflare/wrangler.jsonc --dry-run --outdir .wrangler/connect-build",
    "connect:cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "build": "vite build",
    "build:vr": "node scripts/build-vr-models.mjs",
    "build:tissue-textures": "node scripts/generate-tissue-textures.mjs",
    "build:vercel": "vite build",
    "check": "tsc --noEmit",
    "test:vr": "node scripts/validate-vr-models.mjs",
    "audit:meshes": "node scripts/audit-meshes.mjs",
    "test:sections": "node scripts/validate-section.mjs",
    "test:section-visuals": "node scripts/compare-section-screenshots.mjs",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test mcp/server.test.mjs",
    "import:local-models": "node scripts/import-local-zygote.mjs && node scripts/audit-meshes.mjs local-male local-female",
    "import:reference-glb": "node scripts/import-reference-glb.mjs && node scripts/audit-meshes.mjs local-reference",
    "test:reference-import": "node scripts/validate-reference-import.mjs",
    "test:hierarchies": "node scripts/validate-hierarchy-taxonomy.mjs",
    "build:terminology": "python3 scripts/build-ta98-metadata.py",
    "audit:ta98": "node scripts/audit-ta98-hierarchy.mjs",
    "test:relations": "node scripts/validate-anatomical-relations.mjs",
    "test:relation-reciprocity": "node scripts/validate-relation-reciprocity.mjs",
    "audit:relations": "node scripts/audit-anatomical-coverage.mjs",
    "test:relationship-selection": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/validate-relationship-selection.mjs",
    "test:label-layout": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/validate-label-layout.mjs",
    "test:framing": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/validate-view-framing.mjs",
    "build:anatomical-attachments": "node scripts/build-anatomical-attachments.mjs",
    "import:cell": "node scripts/import-cell.mjs && node scripts/audit-meshes.mjs cell",
    "import:primary-male": "node scripts/import-primary-male.mjs && node scripts/audit-meshes.mjs male-detail",
    "import:primary-female": "node scripts/import-primary-female.mjs && node scripts/audit-meshes.mjs female",
    "import:primary-female-muscles": "node scripts/run-female-muscles.mjs",
    "import:primary-standard": "node scripts/import-primary-standard.mjs && node scripts/audit-meshes.mjs male",
    "build:complete-male": "node scripts/build-complete-male.mjs && node scripts/audit-meshes.mjs male-full && node scripts/build-anatomical-attachments.mjs",
    "build:chakras": "node scripts/build-chakra-hierarchy.mjs",
    "test:chakras": "node scripts/validate-guest-hierarchy.mjs",
    "build:biology": "python3 scripts/build-biological-hierarchies.py",
    "test:biology": "node scripts/validate-biological-hierarchies.mjs",
    "build:drugs": "python3 scripts/build-drug-hierarchy.py",
    "test:drugs": "node scripts/validate-drug-hierarchy.mjs",
    "build:exercise": "node scripts/build-exercise-hierarchy.mjs",
    "test:exercise": "node scripts/validate-exercise-hierarchy.mjs",
    "build:spinal-roots": "node scripts/build-spinal-root-hierarchy.mjs",
    "test:spinal-roots": "node scripts/validate-spinal-root-hierarchy.mjs",
    "build:physiology": "node scripts/build-physiology-hierarchy.mjs",
    "test:physiology": "node scripts/validate-physiology-hierarchy.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@shadcn/react": "0.3.0",
    "@types/three": "0.186.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "ws": "8.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "0.27.3",
    "json5": "2.2.3",
    "meshoptimizer": "^1.2.0",
    "miniflare": "4.20260515.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "license": "GPL-3.0-only"
}
